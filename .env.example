# SmartFlow AI - Configuration Environment Template
# Copy this file to .env and configure your keys

# Google Maps Platform API Key (Required for Live Google Routes v2 and Geocoding)
# Must have Routes API and Geocoding API enabled in Google Cloud Console
GOOGLE_MAPS_API_KEY=

# TomTom Developer API Key (Optional Alternative Provider)
TOMTOM_API_KEY=

# Application Settings
SMARTFLOW_ENV=development
DEFAULT_MAP_THEME=dark
AUTO_REFRESH_INTERVAL=60
